# Cloudflare Pages response headers. Rules stack: every matching block applies.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# The app talks to nothing. connect-src 'none' makes the browser enforce it.
/app
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
/app/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY

# Landing page and install guide: our own files plus the cookie-free analytics script.
/
  Content-Security-Policy: default-src 'self'; script-src 'self' {{analyticsOrigin}}; connect-src 'self' {{analyticsOrigin}}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
/install
  Content-Security-Policy: default-src 'self'; script-src 'self' {{analyticsOrigin}}; connect-src 'self' {{analyticsOrigin}}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Built files have content hashes in their names: cache them for good. The service worker must always be re-checked.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/shots/*
  Cache-Control: public, max-age=86400
/sw.js
  Cache-Control: no-cache
